{
  "name": "pdf",
  "displayName": "vscode-pdf",
  "description": "Display pdf file in VSCode.",
  "version": "1.2.2",
  "publisher": "tomoki1207",
  "engines": {
    "vscode": "^1.46.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "pdf",
    "viewer"
  ],
  "icon": "vscode-pdf.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tomoki1207/vscode-pdfviewer.git"
  },
  "bugs": {
    "url": "https://github.com/tomoki1207/vscode-pdfviewer/issues"
  },
  "activationEvents": [
    "onCustomEditor:pdf.preview",
    "onCommand:pdf-preview.toggleHighlight",
    "onCommand:pdf-preview.commentHighlight",
    "onCommand:pdf-preview.clearHighlights",
    "onCommand:pdf-preview.revealHighlight",
    "onView:pdf-preview.comments"
  ],
  "main": "./out/src/extension",
  "contributes": {
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": true
      }
    },
    "commands": [
      {
        "command": "pdf-preview.toggleHighlight",
        "title": "Toggle Highlight on Selection",
        "category": "PDF"
      },
      {
        "command": "pdf-preview.commentHighlight",
        "title": "Add/Edit Comment on Highlight",
        "category": "PDF"
      },
      {
        "command": "pdf-preview.clearHighlights",
        "title": "Remove All Highlights in This PDF",
        "category": "PDF"
      },
      {
        "command": "pdf-preview.revealHighlight",
        "title": "Go to Comment",
        "category": "PDF"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "pdf-preview.comments",
          "name": "PDF Comments"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pdf-preview.toggleHighlight",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == 'pdf.preview'"
      },
      {
        "command": "pdf-preview.commentHighlight",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == 'pdf.preview'"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pdf-preview.toggleHighlight",
          "when": "activeCustomEditorId == 'pdf.preview'"
        },
        {
          "command": "pdf-preview.commentHighlight",
          "when": "activeCustomEditorId == 'pdf.preview'"
        },
        {
          "command": "pdf-preview.clearHighlights",
          "when": "activeCustomEditorId == 'pdf.preview'"
        },
        {
          "command": "pdf-preview.revealHighlight",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "pdf.preview",
        "displayName": "Pdf Preview",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ]
      }
    ],
    "configuration": {
      "type": "object",
      "title": "PDF Preview",
      "properties": {
        "pdf-preview.default.cursor": {
          "markdownDescription": "The default cursor tool for preview.",
          "type": "string",
          "default": "select",
          "enum": [
            "select",
            "hand"
          ]
        },
        "pdf-preview.default.scale": {
          "markdownDescription": "The default zoom level for preview. Allowed values are `auto`, `page-actual`, `page-fit`, `page-width`, and 1-based scale values. (`1.0` means 100%)",
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$"
        },
        "pdf-preview.default.sidebar": {
          "markdownDescription": "Show the sidebar on load. The default visibility of sidebar for preview. When off, the sidebar also starts closed for PDFs that ask to open with their outline and for PDFs where it was left open. Toggle it with `F4`.",
          "type": "boolean",
          "default": false
        },
        "pdf-preview.default.scrollMode": {
          "markdownDescription": "The default scroll mode for preview.",
          "type": "string",
          "default": "vertical",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped"
          ]
        },
        "pdf-preview.default.spreadMode": {
          "markdownDescription": "The default spread mode for preview.",
          "type": "string",
          "default": "none",
          "enum": [
            "none",
            "odd",
            "even"
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint -c .eslintrc.json --ext .ts ./src",
    "package": "vsce package"
  },
  "dependencies": {
    "@types/vscode": "^1.46.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^12.12.21",
    "@typescript-eslint/eslint-plugin": "^2.28.0",
    "@typescript-eslint/parser": "^2.28.0",
    "eslint": "^6.8.0",
    "eslint-config-prettier": "^6.10.1",
    "eslint-plugin-prettier": "^3.1.3",
    "mocha": "^10.1.0",
    "prettier": "^2.0.4",
    "typescript": "^3.7.3",
    "vsce": "^2.15.0",
    "vscode-dts": "^0.3.1",
    "vscode-test": "^1.3.0"
  },
  "extensionKind": [
    "ui"
  ]
}
